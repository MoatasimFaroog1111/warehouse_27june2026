APP_NAME=Warehouse GroundingDINO API
APP_VERSION=2.0.0
APP_ENV=production
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Set a strong secret in production. Leave empty only for local development.
API_KEY=

GROUNDING_DINO_ROOT=./GroundingDINO
GROUNDING_DINO_CONFIG=./GroundingDINO/groundingdino/config/GroundingDINO_SwinT_OGC.py
GROUNDING_DINO_CHECKPOINT=./GroundingDINO/weights/groundingdino_swint_ogc.pth
GROUNDING_DINO_DEVICE=cpu
PRELOAD_MODEL=false

MAX_UPLOAD_BYTES=15728640
MAX_IMAGE_PIXELS=40000000
MAX_PROMPT_CHARS=500
MAX_PROMPT_TERMS=30
MAX_CONCURRENT_REQUESTS=1

RESULT_DIR=./runtime/results
RESULT_TTL_SECONDS=86400
INCLUDE_BASE64_DEFAULT=false

# Example: https://your-codespace-8000.app.github.dev
PUBLIC_BASE_URL=

# Comma-separated. Leave empty to disable CORS.
CORS_ORIGINS=

# Codespaces uses dynamic hostnames, so "*" is practical during development.
ALLOWED_HOSTS=*
